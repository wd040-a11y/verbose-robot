{
  "name": "rpg-story-player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "desktop": "electron .",
    "dist:win": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.7.57",
    "ajv": "^8.20.0",
    "vite": "^6.1.0"
  },
  "main": "electron.cjs",
  "build": {
    "appId": "org.rpgstoryplayer.app",
    "productName": "RPGStoryPlayer",
    "files": [
      "dist/**/*",
      "electron.cjs"
    ],
    "win": {
      "target": "portable"
    },
    "directories": {
      "output": "release"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.6",
    "prettier": "^3.9.10"
  }
}
